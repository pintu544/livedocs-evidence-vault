# Copy to .env and fill in. Never commit .env to git.
# Free key: https://serpapi.com/users/sign_up (250 searches/month, no card required)

# Required — SerpApi key used for all live searches
SERPAPI_API_KEY=

# Server port (default 4000)
PORT=4000

# Optional — any OpenAI-compatible chat endpoint for richer AI summaries.
# Without these, the app uses an extractive report built from search snippets.
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Optional: per-IP research rate limit (runs per 10 min, default 20)
# RESEARCH_RATE_LIMIT_MAX=20
LLM_API_KEY=

# Optional — S3 evidence archive (AWS Weekend Challenge build).
# When S3_BUCKET is set, every research run archives report.md + evidence.json
# to s3://<bucket>/evidence/<runId>/ and returns 7-day presigned URLs.
# AWS_REGION=ap-south-1
# S3_BUCKET=livedocs-evidence-vault
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
